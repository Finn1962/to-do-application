<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
    <link rel="stylesheet" href="/custom.css" />
    <link rel="stylesheet" href="/css/bootstrap-custom.css" />
    <script src="/settings-buttons.js" defer></script>
  </head>
  <body
    class="d-flex flex-column justify-content-start align-items-center flex-column vh-100 vw-100"
  >
    <main class="form-signin pt-5" style="min-width: 350px">
      <a href="/" class="text-decoration-none">← Back</a>
      <h1 class="h3 mb-3 mt-3 fw-normal text-body-secondary">Settings</h1>
      <p class="mb-1 text-secondary">Change password</p>
      <hr class="mb-4" />
      <form action="/login" method="POST" class="mb-5 username-and-mail-form">
        <div class="form-floating">
          <input
            type="text"
            class="username form-control mb-2"
            id="floatingInput"
            placeholder="name@example.com"
            name="username"
            value="<%=userData.username%>"
            required
          />
          <label for="floatingInput">Username</label>
        </div>
        <div class="form-floating">
          <input
            type="email"
            class="email form-control"
            id="floatingInput"
            placeholder="name@example.com"
            name="email"
            value="<%=userData.email%>"
            required
          />
          <label for="floatingInput">Email</label>
        </div>
        <button
          class="btn btn-primary w-100 py-2 mt-4 m-0 text-white"
          type="submit"
          style="display: none"
        >
          Save
        </button>
      </form>
      <p class="mb-1">Change password</p>
      <hr class="mb-4" />
      <form action="/login" method="POST" class="mb-5 password password-form">
        <div class="form-floating">
          <input
            type="password"
            class="form-control mb-2 password"
            id="floatingPassword"
            placeholder="Password"
            name="password"
            value="<%userData.email%>"
            required
          />
          <label for="floatingPassword">New password</label>
        </div>
        <div class="form-floating">
          <input
            type="password"
            class="form-control confirmPassword"
            id="floatingPassword"
            placeholder="Password"
            name="confirmPassword"
            required
          />
          <label for="floatingPassword">Confirm new password</label>
        </div>
        <button
          class="btn btn-primary w-100 py-2 mt-4 text-white"
          type="submit"
          style="display: none"
        >
          Save
        </button>
      </form>
      <p class="mb-1 text-danger">Danger zone!</p>
      <hr class="mb-3" />
      <button class="btn btn-danger w-100 py-2 text-white" type="submit">
        Delete account
      </button>
      <p class="text-danger mt-1">
        <% if (typeof error !== 'undefined') { %> <%= error %> <% } %>
      </p>
      <p class="mt-5 mb-3 text-body-secondary">© 2026 By Finn Schmidt</p>
    </main>

    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
      crossorigin="anonymous"
    ></script>
  </body>
</html>
