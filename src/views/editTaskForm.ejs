<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>FOCUS TO-DO</title>
    <link rel="icon" type="image/png" href="/favicon.svg" />
    <link
      href="https://cdn.jsdelivr.net/npm/quill@2.0.2/dist/quill.snow.css"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/custom.css" />
    <link rel="stylesheet" href="/css/bootstrap-custom.css" />
    <script src="/quill-editor.js" defer></script>
    <script src="/edit-task-form.js" defer></script>
  </head>
  <body
    class="d-flex justify-content-center align-items-center flex-column vh-100 vw-100"
  >
    <main class="form-signin m-auto" style="min-width: 350px">
      <h1 class="h3 mb-3 fw-normal text-body-secondary">Edit Task</h1>
      <form class="mb-4" action="/task/edit" method="POST">
        <div class="form-floating">
          <input
            type="text"
            class="form-control mb-2"
            id="floatingInput"
            placeholder="Project Title"
            name="title"
            value="<%=taskData.title%>"
            required
          />
          <label for="floatingInput">Title</label>
        </div>
        <div id="editor"><%-taskData.description%></div>
        <input type="hidden" name="description" id="description" required />
        <input type="hidden" name="taskId" value="<%=taskId%>" required />
        <input type="hidden" name="projectId" value="<%=projectId%>" required />
        <button
          class="btn btn-primary w-100 py-2 mt-3 text-white"
          type="submit"
        >
          Save Changes
        </button>
      </form>
      <a
        href="/?projectId=<%=projectId%>&taskId=<%=taskId%>"
        class="text-decoration-none"
        >← Back</a
      >
    </main>

    <script src="https://cdn.jsdelivr.net/npm/quill@2.0.2/dist/quill.js"></script>
    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
      crossorigin="anonymous"
    ></script>
  </body>
</html>
