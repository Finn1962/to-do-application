<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>FOCUS TO-DO</title>
    <link rel="icon" type="image/png" href="/favicon.svg" />
    <link rel="stylesheet" href="/css/custom.css" />
    <link rel="stylesheet" href="/css/bootstrap-custom.css" />
    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
      defer
    ></script>
    <script src="/partial-renderings.js" defer></script>
    <script src="/responsiveness.js" defer></script>
  </head>
  <body>
    <!--href for new task button is updated in partial-rendering.js-->
    <a
      href="<%=`/task/new/${selectedProject?.id}`%>"
      type="button"
      class="btn btn-light shadow position-fixed end-0 bottom-0 z-3 me-3 mb-5 fw-bold add-button new-task-button"
      style="transform: translateY(-50px)"
    >
      ➕ Add Task
    </a>
    <a
      href="/project/new"
      class="btn btn-light shadow position-fixed end-0 bottom-0 z-3 me-3 mb-5 fw-bold add-button"
      type="button"
      style="transform: translateY(-5px)"
      >➕ Add Project
    </a>
    <div class="d-flex flex-column p-0 vh-100 z-0 overflow-hidden">
      <header
        class="bg-light d-flex justify-content-between align-items-start pt-3 pb-1 ps-3 pe-3 m-0 d-lg-none"
        style="height: 50px"
      >
        <label class="burger" for="burger">
          <input type="checkbox" id="burger" class="burger-button" />
          <span></span>
          <span></span>
          <span></span>
        </label>

        <img src="/logo-var-two.svg" alt="logo" height="20" />
      </header>
      <div class="flex-grow-1 d-flex p-0 overflow-hidden">
        <div
          class="menu slide-in-left d-none d-lg-flex flex-column flex-shrink-0 p-3 bg-body-tertiary flex-grow-0"
          style="width: 300px"
        >
          <div
            class="d-none d-lg-flex align-items-center justify-content-start mb-3 ms-1 mt-3"
          >
            <img src="/logo-var-two.svg" alt="logo" width="200" />
          </div>

          <ul
            class="nav nav-pills flex-nowrap flex-column mb-auto project-container overflow-y-auto"
          >
            <%- include('partials/projects') %>
          </ul>

          <div class="aligm-self-end">
            <hr />
            <div class="dropdown">
              <div
                class="d-flex align-items-center link-body-emphasis text-decoration-none dropdown-toggle cursor-pointer"
                data-bs-toggle="dropdown"
                aria-expanded="false"
              >
                <div
                  class="rounded-circle me-2 bg-primary d-flex justify-content-center align-items-center text-white fs-5 fw-medium"
                  style="height: 32px; width: 32px"
                >
                  <%=userData.username[0]%>
                </div>
                <strong><%=userData.username%></strong>
              </div>
              <ul class="dropdown-menu text-small shadow">
                <li><a class="dropdown-item" href="/settings">Profile</a></li>
                <li><hr class="dropdown-divider" /></li>
                <li><a class="dropdown-item" href="/logout">Sign out</a></li>
              </ul>
            </div>
          </div>
        </div>

        <div
          class="overflow-y-auto list-group flex-grow-1 position-relative tasks-list"
          style="border-radius: 0; height: 100%"
        >
          <%- include('partials/tasks') %>
        </div>

        <div
          class="d-none d-md-block flex-grow-1 border p-3 w-100 description-container"
          style="max-width: 400px"
        >
          <%- include('partials/taskDescription') %>
        </div>
      </div>
      <footer
        class="flex-shrink-0 d-flex justify-content-center align-items-center bg-dark"
        style="height: 38px"
      >
        <small>
          <p class="text-white fw-lighter m-0 me-1">
            Copyright © 2026 Finn Schmidt
          </p>
        </small>
        <img src="/github-logo.svg" class="h-100 p-2" />
      </footer>
    </div>
  </body>
</html>
