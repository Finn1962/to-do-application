<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Home</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/base.css" />
    <link rel="stylesheet" href="/custom.css" />
    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
      defer
    ></script>
  </head>
  <body>
    <div class="d-flex flex-column position-relative p-0 vw-100 vh-100">
      <a
        href="<%=`/task/new/${selectedProject?.id}`%>"
        type="button"
        class="btn btn-light shadow position-fixed end-0 bottom-0 z-5 me-3 mb-5 fw-bold"
        style="transform: translateY(-50px)"
      >
        ➕ Add Task
      </a>
      <a
        href="/project/new"
        class="btn btn-light shadow position-fixed end-0 bottom-0 z-5 me-3 mb-5 fw-bold"
        type="button"
        style="transform: translateY(-5px)"
        >➕ Add Project
      </a>
      <div class="d-flex flex-grow-1 p-0 vw-100">
        <div
          class="d-flex flex-column flex-shrink-0 p-3 bg-body-tertiary flex-grow-0"
          style="width: 280px"
        >
          <a
            href="/"
            class="d-flex align-items-center mb-3 mb-md-0 me-md-auto link-body-emphasis text-decoration-none"
          >
            <img class="bi pe-none me-2 h-75" src="/logo.svg" alt="logo" />
            <span class="fs-4">ToDo</span>
          </a>
          <hr />

          <ul class="nav nav-pills flex-column mb-auto">
            <% projects.forEach((project)=>{ %>
            <%if (project.id === selectedProject.id) {%>
            <li class="nav-item">
              <div
                class="nav-link cursor-pointer active d-flex justify-content-between"
                aria-current="page"
              >
                <p class="m-0"><%=project.title%></p>
                <div class="d-flex gap-3">
                  <a
                    href="/project/edit/<%=selectedProject?.id%>"
                    class="d-flex justify-content-center align-items-center bg-transparent border-0 p-0"
                  >
                    <img src="/pencil-square.svg" class="invert-image" />
                  </a>
                  <%if (projects.length > 1) {%>
                  <a
                    href="/project/delete/<%=selectedProject?.id%>"
                    class="d-flex justify-content-center align-items-center bg-transparent border-0 p-0"
                  >
                    <img src="/trash.svg" class="invert-image" />
                  </a>
                  <%}%>
                </div>
              </div>
            </li>
            <%} else {%>
            <li>
              <a
                href="<%=`/?projectId=${project.id}`%>"
                class="nav-link link-body-emphasis"
              >
                <%=project.title%>
              </a>
            </li>
            <%}%>
            <% }); %>
          </ul>
          <div class="d-grid gap-2"></div>
          <hr />
          <div class="dropdown">
            <a
              href="#"
              class="d-flex align-items-center link-body-emphasis text-decoration-none dropdown-toggle"
              data-bs-toggle="dropdown"
              aria-expanded="false"
            >
              <img
                src="https://github.com/mdo.png"
                alt=""
                width="32"
                height="32"
                class="rounded-circle me-2"
              />
              <strong>mdo</strong>
            </a>
            <ul class="dropdown-menu text-small shadow">
              <li><a class="dropdown-item" href="#">New project...</a></li>
              <li><a class="dropdown-item" href="#">Settings</a></li>
              <li><a class="dropdown-item" href="#">Profile</a></li>
              <li><hr class="dropdown-divider" /></li>
              <li><a class="dropdown-item" href="#">Sign out</a></li>
            </ul>
          </div>
        </div>
        <div
          class="list-group flex-grow-1 position-relative"
          style="border-radius: 0"
        >
          <% assignedTasks?.forEach((task)=>{ %>
          <%if (task.id === selectedTask.id) {%>
          <a
            href="<%=`/?projectId=${selectedProject.id}&taskId=${task.id}`%>"
            class="list-group-item list-group-item-action active z-0"
            aria-current="true"
            style="height: 78.5px; padding: 14px 16px 14px 16px"
          >
            <div class="d-flex w-100 justify-content-between">
              <p class="mb-1 fw-bold"><%=task.title%></p>
              <small><%=task.created_at.toLocaleDateString('de-DE')%></small>
            </div>
            <div class="col-10 mb-1 small" style="transform: translateY(-4px)">
              <%=task.description.slice(0, 50)%>
            </div>
          </a>
          <%} else {%>
          <a
            href="<%=`/?projectId=${selectedProject.id}&taskId=${task.id}`%>"
            class="list-group-item list-group-item-action py-3 lh-sm"
          >
            <div
              class="d-flex w-100 align-items-center justify-content-between"
            >
              <strong class="mb-1"><%=task.title%></strong>
              <small class="text-body-secondary mb-1">
                <%=task.created_at.toLocaleDateString('de-DE')%>
              </small>
            </div>
            <div class="col-10 mb-1 small">
              <%=task.description.slice(0, 50)%>
            </div>
          </a>
          <%}%>
          <% }); %>
          <%if (assignedTasks?.length === 0) {%>
          <img
            class="position-absolute top-50 start-50 translate-middle"
            style="width: 100%; max-width: 600px"
            src="/grafic-one.svg"
          />
          <p
            class="fw-bold position-absolute start-50 translate-middle fs-5"
            style="bottom: 20px"
          >
            Nothing is happening here yet!
          </p>
          <p class="position-absolute bottom-0 start-50 translate-middle">
            Add a Task.
          </p>
          <%}%>
        </div>
        <div class="flex-grow-1 border p-3" style="max-width: 400px">
          <%if (assignedTasks?.length > 0) {%>
          <div
            class="d-flex justify-content-between align-items-center pb-3 mb-3 border-bottom"
          >
            <div class="d-flex gap-3">
              <a
                href="/task/edit/<%=selectedTask?.id%>?projectId=<%=selectedProject?.id%>"
                class="d-flex justify-content-center align-items-center bg-transparent border-0 p-0"
              >
                <img src="/pencil-square.svg" />
              </a>
              <a
                href="/task/delete/<%=selectedTask?.id%>?projectId=<%=selectedProject?.id%>"
                class="d-flex justify-content-center align-items-center bg-transparent border-0 p-0"
              >
                <img src="/trash.svg" />
              </a>
            </div>

            <p class="m-0">
              <%=selectedTask?.created_at.toLocaleDateString('de-DE')%>
            </p>
          </div>
          <%}%>
          <h5><%=selectedTask?.title%></h5>
          <p><%=selectedTask?.description%></p>
        </div>
      </div>
      <footer
        class="flex-grow-0 d-flex justify-content-center align-items-center bg-dark"
        style="height: 38px"
      >
        <small>
          <p class="text-white fw-lighter m-0 me-1">
            Copyright © 2026 Finn Schmidt
          </p>
        </small>
        <img src="/github-logo.svg" class="h-100 p-2" />
      </footer>
    </div>
  </body>
</html>
