<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Home</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/custom.css" />
    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
      defer
    ></script>
  </head>
  <body>
    <div class="d-flex flex-column p-0 vw-100 vh-100">
      <div class="d-flex flex-grow-1 p-0 vw-100">
        <div
          class="d-flex flex-column flex-shrink-0 p-3 bg-body-tertiary flex-grow-0"
          style="width: 280px"
        >
          <a
            href="/"
            class="d-flex align-items-center mb-3 mb-md-0 me-md-auto link-body-emphasis text-decoration-none"
          >
            <img class="bi pe-none me-2 h-75" src="/logo.svg" alt="logo" />
            <span class="fs-4">whatToDo</span>
          </a>
          <hr />

          <ul class="nav nav-pills flex-column mb-auto">
            <% projects.forEach((project)=>{ %>
            <%if (project.id === selectedProject.id) {%>
            <li class="nav-item">
              <a
                href="<%=`/?projectId=${project.id}`%>"
                class="nav-link active d-flex justify-content-between"
                aria-current="page"
              >
                <h5 class="m-0"><%=project.title%></h5>
                <div class="d-flex gap-3">
                  <button
                    class="d-flex justify-content-center align-items-center bg-transparent border-0 p-0"
                  >
                    <img src="/pencil-square.svg" class="invert-image" />
                  </button>
                  <button
                    class="d-flex justify-content-center align-items-center bg-transparent border-0 p-0"
                  >
                    <img src="/trash.svg" class="invert-image" />
                  </button></div
              ></a>
            </li>
            <%} else {%>
            <li>
              <a
                href="<%=`/?projectId=${project.id}`%>"
                class="nav-link link-body-emphasis"
              >
                Dashboard
              </a>
            </li>
            <%}%>
            <% }); %>
          </ul>

          <div class="d-grid gap-2">
            <a href="/project/new" class="btn btn-outline-primary" type="button"
              >Add Project</a
            >
          </div>

          <hr />
          <div class="dropdown">
            <a
              href="#"
              class="d-flex align-items-center link-body-emphasis text-decoration-none dropdown-toggle"
              data-bs-toggle="dropdown"
              aria-expanded="false"
            >
              <img
                src="https://github.com/mdo.png"
                alt=""
                width="32"
                height="32"
                class="rounded-circle me-2"
              />
              <strong>mdo</strong>
            </a>
            <ul class="dropdown-menu text-small shadow">
              <li><a class="dropdown-item" href="#">New project...</a></li>
              <li><a class="dropdown-item" href="#">Settings</a></li>
              <li><a class="dropdown-item" href="#">Profile</a></li>
              <li><hr class="dropdown-divider" /></li>
              <li><a class="dropdown-item" href="#">Sign out</a></li>
            </ul>
          </div>
        </div>

        <div
          class="list-group flex-grow-1 position-relative"
          style="border-radius: 0"
        >
          <% assignedTasks.forEach((task)=>{ %>
          <a
            href="#"
            class="list-group-item list-group-item-action active z-0"
            aria-current="true"
          >
            <div class="d-flex w-100 justify-content-between">
              <h5 class="mb-1"><%=task.title%></h5>
              <small><%=task.created_at.toLocaleDateString('de-DE')%></small>
            </div>
            <small><%=task.description%></small>
          </a>
          <% }); %>
          <button
            type="button"
            class="btn btn-outline-primary position-absolute bottom-0 end-0 z-5 mb-3 me-3"
          >
            Add Task
          </button>
        </div>

        <div class="flex-grow-1 border p-3" style="max-width: 400px">
          <div
            class="d-flex justify-content-between align-items-center pb-3 mb-3 border-bottom"
          >
            <div class="d-flex gap-3">
              <button
                class="d-flex justify-content-center align-items-center bg-transparent border-0 p-0"
              >
                <img src="/pencil-square.svg" />
              </button>
              <button
                class="d-flex justify-content-center align-items-center bg-transparent border-0 p-0"
              >
                <img src="/trash.svg" />
              </button>
            </div>

            <p class="m-0">
              <%=selectedTask?.created_at.toLocaleDateString('de-DE')%>
            </p>
          </div>
          <h5><%=selectedTask?.title%></h5>
          <p><%=selectedTask?.description%></p>
        </div>
      </div>

      <div
        class="flex-grow-0 d-flex justify-content-center align-items-center bg-dark"
        style="height: 40px"
      >
        <small>
          <p class="text-white fw-lighter m-0 me-1">
            Copyright © 2026 Finn Schmidt
          </p>
        </small>
        <img src="/github-logo.svg" class="h-100 p-2" />
      </div>
    </div>
  </body>
</html>
