<% assignedTasks?.forEach((task)=>{ %>
<%if (task.id === selectedTask.id) {%>
<a
  data-href="<%=`/renderTasks/${selectedProject.id}/${task.id}`%>"
  data-project-id="<%=selectedProject.id%>"
  data-task-id="<%=task.id%>"
  class="list-group-item list-group-item-action active z-0"
  aria-current="true"
  style="height: 78.5px; padding: 14px 16px 14px 16px"
>
  <div class="d-flex w-100 justify-content-between">
    <%if (task.completed) {%>
    <s class="mb-0">
      <p class="m-0">
        <strong><%=task.title%></strong>
      </p>
    </s>
    <%} else {%>
    <p class="m-0">
      <strong><%=task.title%></strong>
    </p>
    <%}%>
    <small
      ><p class="m-0"><%=task.created_at.toLocaleDateString('de-DE')%></p>
    </small>
  </div>
  <p class="col-10 mb-1 small" style="transform: translateY(-4px)">
    <%=task.description.replace(/<[^>]*>/g, ' ').substring(0, 50)%>
  </p>
</a>
<%} else {%>
<a
  data-href="<%=`/renderTasks/${selectedProject.id}/${task.id}`%>"
  data-project-id="<%=selectedProject.id%>"
  data-task-id="<%=task.id%>"
  class="list-group-item list-group-item-action py-3 lh-sm"
>
  <div class="d-flex w-100 align-items-center justify-content-between">
    <%if (task.completed) {%>
    <s class="mb-0">
      <p class="m-0 text-body-tertiary">
        <strong><%=task.title%></strong>
      </p>
    </s>
    <%} else {%>
    <p class="m-0">
      <strong><%=task.title%></strong>
    </p>
    <%}%>
    <small class="text-body-secondary mb-1">
      <p class="<%if (task.completed) {%>text-body-tertiary<%}%> m-0">
        <%=task.created_at.toLocaleDateString('de-DE')%>
      </p>
    </small>
  </div>
  <p class="<%if (task.completed) {%>text-body-tertiary<%}%> col-10 mb-1 small">
    <%=task.description.replace(/<[^>]*>/g, ' ').substring(0, 50)%>
  </p>
</a>
<%}%>
<% }); %>
<%if (assignedTasks?.length === 0) {%>
<img
  class="position-absolute top-50 start-50"
  style="width: 100%; max-width: 600px; transform: translate(-50%, -60%)"
  src="/grafic-one.svg"
/>
<p
  class="fw-bold position-absolute start-50 translate-middle fs-5 text-center w-100"
  style="bottom: 120px"
>
  Nothing is happening here yet!
</p>
<p class="position-absolute start-50 translate-middle" style="bottom: 90px">
  Add a Task.
</p>
<%}%>
