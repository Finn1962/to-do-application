<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />

    <style type="text/css">
      html,
      body {
        margin: 0;
        padding: 0;
        width: 100%;
        height: 100%;
        background-color: #f4f6f9;
        font-family: Arial, Helvetica, sans-serif;
        font-size: 16px;
        line-height: 1.6;
        color: #333333;
        -webkit-text-size-adjust: 100%;
        -ms-text-size-adjust: 100%;
      }

      table,
      td {
        border-collapse: collapse;
        border-spacing: 0;
        mso-table-lspace: 0pt;
        mso-table-rspace: 0pt;
      }

      img {
        border: 0;
        height: auto;
        line-height: 100%;
        outline: none;
        text-decoration: none;
        display: block;
        max-width: 100%;
      }

      a {
        color: #2563eb;
        text-decoration: underline;
      }

      .body-table {
        width: 100%;
        background-color: #f4f6f9;
        padding: 40px 10px;
      }

      .main-wrapper {
        width: 100%;
        max-width: 600px;
        margin: 0 auto;
      }

      .card {
        background-color: #ffffff;
        border-radius: 8px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
        overflow: hidden;
      }

      .header-td {
        background-color: #1e293b;
        padding: 30px 40px;
        text-align: center;
      }

      .logo-text {
        color: #ffffff;
        font-size: 24px;
        font-weight: bold;
        letter-spacing: 1px;
        text-transform: uppercase;
        margin: 0;
      }

      .content-td {
        padding: 40px;
      }

      .heading-h1 {
        margin-top: 0;
        margin-bottom: 20px;
        font-size: 24px;
        font-weight: bold;
        color: #0f172a;
      }

      .paragraph {
        margin-top: 0;
        margin-bottom: 20px;
        color: #475569;
      }

      .highlight-box {
        background-color: #eff6ff;
        border-left: 4px solid #7584f1;
        padding: 16px;
        margin-bottom: 24px;
        border-radius: 0 4px 4px 0;
      }

      .highlight-text {
        margin: 0;
        font-size: 14px;
        color: #7584f1;
      }

      .button-container-td {
        padding: 10px 20px 30px 20px;
        text-align: center;
      }

      .btn-link {
        background-color: #7584f1;
        color: #ffffff;
        padding: 14px 28px;
        border-radius: 6px;
        width: 85%;
        font-weight: bold;
        display: inline-block;
        text-decoration: none;
        text-align: center;
      }

      .footer-td {
        padding: 30px 40px;
        background-color: #f8fafc;
        border-top: 1px solid #e2e8f0;
        text-align: center;
      }

      .footer-text {
        font-size: 12px;
        color: #94a3b8;
        margin: 0 0 10px 0;
      }

      .footer-link {
        color: #64748b;
        text-decoration: underline;
      }

      @media screen and (max-width: 600px) {
        .body-table {
          padding: 10px !important;
        }
        .content-td {
          padding: 24px 20px !important;
        }
        .header-td {
          padding: 20px !important;
        }
        .btn-link {
          display: block !important;
          width: 100% !important;
          box-sizing: border-box !important;
        }
      }
    </style>
  </head>
  <body>
    <table class="body-table">
      <tr>
        <td>
          <table class="main-wrapper">
            <tr>
              <td class="card">
                <table style="width: 100%">
                  <tr>
                    <td class="header-td">
                      <span class="logo-text">FOCUS TO-DO</span>
                    </td>
                  </tr>
                </table>
                <table style="width: 100%">
                  <tr>
                    <td class="content-td">
                      <h1 class="heading-h1">Hello <%=username%>,</h1>
                      <p class="paragraph">
                        You have successfully changed your password.
                      </p>

                      <p class="paragraph" style="margin-bottom: 0">
                        Best regards,<br />
                        the Focus To-Do team
                      </p>
                    </td>
                  </tr>
                </table>
                <table style="width: 100%">
                  <tr>
                    <td class="footer-td">
                      <p class="footer-text">
                        You received this email because you wanted to change
                        your password for Focus TO-DO.
                      </p>
                      <p class="footer-text">&copy; 2026 FOCUS TO-DO.</p>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
