<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
    <link rel="stylesheet" href="/custom.css" />
    <link rel="stylesheet" href="/css/bootstrap-custom.css" />
  </head>
  <body
    class="d-flex justify-content-center align-items-center flex-column vh-100 vw-100"
  >
    <main class="form-signin m-auto" style="min-width: 350px">
      <form class="mb-4" action="/project/new" method="POST">
        <h1 class="h3 mb-3 fw-normal text-body-secondary">New Project</h1>
        <div class="form-floating">
          <input
            type="text"
            class="form-control mb-2"
            id="floatingInput"
            placeholder="Project Title"
            name="title"
          />
          <label for="floatingInput">Title</label>
        </div>
        <button
          class="btn btn-primary w-100 py-2 mt-3 text-white"
          type="submit"
        >
          Create Project
        </button>
      </form>

      <a href="/" class="text-decoration-none">← Back</a>
    </main>

    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
      crossorigin="anonymous"
    ></script>
  </body>
</html>
