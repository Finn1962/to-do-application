<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>FOCUS TO-DO</title>
    <link rel="icon" type="image/png" href="/favicon.svg" />
    <link rel="stylesheet" href="/custom.css" />
    <link rel="stylesheet" href="/css/bootstrap-custom.css" />
    <script src="/new-verification-button.js" defer></script>
  </head>
  <body
    class="d-flex justify-content-center align-items-center flex-column vh-100 vw-100"
  >
    <main class="form-signin m-auto" style="min-width: 350px">
      <form action="/register/verification" method="get">
        <h1 class="h3 mb-3 fw-normal text-body-secondary">
          Enter your verification code.
        </h1>
        <p>We have sent you an email with a verification code.</p>
        <div class="form-floating">
          <input
            type="text"
            class="form-control mb-2"
            id="floatingInput"
            placeholder="123211"
            name="verificationToken"
            required
          />
          <label for="floatingInput">Your code</label>
          <input type="hidden" value="<%=userId%>" name="userId" required />
          <button
            class="btn btn-primary w-100 py-2 mt-3 text-white"
            type="submit"
          >
            Verify
          </button>
          <button
            class="btn btn-secondary w-100 py-2 mt-3 text-white"
            id="new_verification_button"
            type="button"
            data-user-id="<%=userId%>"
          >
            Send new code
          </button>
        </div>
      </form>
      <p class="text-danger mt-1">
        <% if (typeof error !== 'undefined') { %> <%= error %> <% } %>
      </p>
      <a href="/login" class="text-decoration-none">Back to login</a>
    </main>

    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
      crossorigin="anonymous"
    ></script>
  </body>
</html>
